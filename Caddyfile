{
	admin off
	auto_https off

	log {
		format json
	}
}

:{$CADDY_PORT:8080} {
	log {
		format json
		output stdout
	}

	@cors_origin {
		header_regexp Origin ^https?://({$CORS_DOMAINS:localhost})$
	}

	@cors_preflight {
		method OPTIONS
		header_regexp Origin ^https?://({$CORS_DOMAINS:localhost})$
	}

	@prefix {
		expression "{$PATH_PREFIX:}" != ""
		path {$PATH_PREFIX:} {$PATH_PREFIX:}/*
	}

	handle @cors_preflight {
		header {
			Access-Control-Allow-Origin "{header.Origin}"
			Access-Control-Allow-Methods "GET,OPTIONS"
			Access-Control-Allow-Headers "{$ALLOWED_HEADERS:*}"
			Access-Control-Max-Age "86400"
			Vary "Origin"
		}
		respond 204
	}

	header @cors_origin {
		Access-Control-Allow-Origin "{header.Origin}"
		+Vary "Origin"
	}

	uri @prefix strip_prefix {$PATH_PREFIX:/_prefix_not_set}

	import {$CADDY_IMPORTS_PATH:/etc/caddy.d/*}

	@healthcheck {
		path /
		header User-Agent kube-probe/*
	}
	respond @healthcheck 200

	root * {$PUBLIC_RESOURCES_DIR:/public}
	encode gzip

	# Emit a Cache-Control header so browsers actually honor the ETag /
	# Last-Modified validators file_server already sets. With NO Cache-Control,
	# browsers fall back to *heuristic* freshness and skip revalidation, so an
	# updated asset (notably an ES-module bundle served under /-/modules/*) keeps
	# executing the stale cached copy even across a hard reload. The default
	# `no-cache` does NOT disable caching: the response is still stored, but the
	# browser must revalidate via a conditional request (-> 304 when unchanged,
	# fresh bytes when changed) before reuse. Override per deployment via the
	# CACHE_CONTROL env (e.g. `public, max-age=31536000, immutable` for
	# content-hashed URLs). See kdex-tech/backend-static#3, kdex-tech/host-manager#139.
	header Cache-Control "{$CACHE_CONTROL:no-cache}"

	file_server
}
